# VillageSoft Environment Configuration

# Option A: Google Apps Script Web App URL (100% Free, directly connects to your Google Sheet)
# Example: GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb.../exec
GOOGLE_SHEET_WEBHOOK_URL=

# Option B: SheetDB API URL (alternative easy Google Sheet connector)
# Example: SHEETDB_URL=https://sheetdb.io/api/v1/your_api_id
SHEETDB_URL=
